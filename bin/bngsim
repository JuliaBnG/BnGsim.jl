#!/usr/bin/env bash
# The BnGsim command line. Runs `BnGsim.cli` in the Julia environment given
# by BNGSIM_PROJECT (default: the environment of this checkout) with
# BNGSIM_THREADS threads (default: auto). See `bngsim --help` and the
# exit codes in the BnGsim documentation (ExitCode).
#
# Signals: the first SIGINT (Ctrl-C) or SIGTERM (a job scheduler, `kill`)
# during `bngsim run` or `resume` creates DIR/CANCEL, so the run stops at
# the next time step with its state saved (exit code 7) and `bngsim resume
# DIR` continues it. Before the run has saved any state, or on a second
# signal, Julia is stopped at once (SIGTERM, then SIGKILL after 3 s; the last
# saved state, if any, is kept, as state files are written atomically).
set -uo pipefail
set -m                # job control: Julia runs in its own process group
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
dir=""
case "${1:-}" in
    run) prev=""; for a in "$@"; do [ "$prev" = "--out" ] && dir="$a"; prev="$a"; done ;;
    resume) dir="${2:-}" ;;
esac
"${JULIA:-julia}" --startup-file=no --project="${BNGSIM_PROJECT:-$here}" \
    --threads="${BNGSIM_THREADS:-auto}" \
    -e 'using BnGsim; exit(BnGsim.cli(ARGS))' -- "$@" &
child=$!
stop() {
    if [ -n "$dir" ] && [ -d "$dir/.bngsim-run" ] && [ ! -e "$dir/CANCEL" ]; then
        touch "$dir/CANCEL"
    else
        # Nothing (more) to save: SIGTERM, then SIGKILL if Julia is still
        # running after 3 s (it does not always exit on SIGTERM).
        kill -TERM "$child" 2>/dev/null
        for _ in $(seq 30); do
            kill -0 "$child" 2>/dev/null || return
            sleep 0.1
        done
        kill -KILL "$child" 2>/dev/null
    fi
}
trap stop TERM INT
while true; do
    wait "$child"
    status=$?
    kill -0 "$child" 2>/dev/null || exit "$status"
done
